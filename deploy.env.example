# Deployment configuration. Copy to deploy.env (not in Git) and adjust.
# zskarte.sh reads this file for every command and derives the public URLs from it.
# After changing a URL (or ZSK_TRAEFIK) run: ./zskarte.sh start -b

# false: local development, services on localhost ports
# true:  behind Traefik, services on the hostnames below (HTTPS via Traefik)
ZSK_TRAEFIK=false

# Traefik settings (only used when ZSK_TRAEFIK=true)
ZSK_TRAEFIK_NETWORK=proxy-network
ZSK_TRAEFIK_ENTRYPOINT=websecure
ZSK_TRAEFIK_CERTRESOLVER=myresolver

# Public hostnames (only used when ZSK_TRAEFIK=true, without scheme and path)
ZSK_APP_HOST=maps.example.org
ZSK_API_HOST=api.maps.example.org
ZSK_SEARCH_HOST=search.maps.example.org
ZSK_TILES_HOST=tiles.maps.example.org

# Link auf das Git-Repo, wird auf der Login-Seite hinter der Versionsangabe verlinkt (leer = kein Link)
GIT_URL=https://github.com/itzsoweli/offlinekarte

# Organisationsname für das Suchfeld, ergibt "<Name> (lokale Suche)". Leer lassen: "Lokale Suche". Leerzeichen: in Anführungszeichen setzen
ZSK_ORG_NAME=""

# Schaltfläche "Login mit Code" auf der Login-Seite anzeigen: true oder false (Standard: true)
ZSK_CODE_LOGIN=true

# Schaltfläche "Offline lokal arbeiten" auf der Login-Seite anzeigen: true oder false (Standard: true)
ZSK_WORK_LOCAL=true

# Größte erlaubte Datei beim Hochladen von Kartenlayern in MB (Standard: 50). Die Datei wird im Server komplett eingelesen.
ZSK_MAX_UPLOAD_MB=50
