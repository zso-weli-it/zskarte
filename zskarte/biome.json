{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!dist",
			"!**/.gitignore"
		]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 120,
		"lineEnding": "lf",
		"includes": [
			"**"
		]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "off",
				"noDuplicateTestHooks": "off",
				"noAssignInExpressions": "off",
				"noImplicitAnyLet": "off",
				"noGlobalIsNan": "off",
				"useIterableCallbackReturn": "off",
				"noNonNullAssertedOptionalChain": "off"
			},
			"style": {
				"useImportType": "off",
				"useNumberNamespace": "off",
				"noUselessElse": "off",
				"noParameterAssign": "off",
				"useNodejsImportProtocol": "off",
				"useTemplate": "off",
				"noNonNullAssertion": "off",
				"useSingleVarDeclarator": "off",
				"useExponentiationOperator": "off"
			},
			"complexity": {
				"noForEach": "off",
				"useLiteralKeys": "off",
				"noStaticOnlyClass": "off",
				"noThisInStatic": "off",
				"useArrowFunction": "off"
			},
			"performance": {
				"noDelete": "off",
				"noAccumulatingSpread": "off"
			},
			"correctness": {
				"noUnsafeOptionalChaining": "off",
				"noInvalidUseBeforeDeclaration": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"css": {
		"linter": {
			"enabled": false
		}
	},
	"html": {
		"linter": {
			"enabled": false
		}
	}
}
