{
  "name": "@zskarte/app",
  "version": "7.0.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ng:serve": "ng serve --port 4300 --host 0.0.0.0",
    "ng:serve:dev": "ng serve --port 4300 --host 0.0.0.0 --configuration development",
    "ng:serve:prod": "ng serve --port 4300 --host 0.0.0.0 --configuration production",
    "ng:serve:e2e": "npm-run-all -p ng:serve:dev wait",
    "ngsw:update": "node scripts/update-ngsw-config.js",
    "ng:build:prod": "npm run ngsw:update && ng build --configuration production",
    "ng:build:dev": "npm run ngsw:update && ng build --configuration development",
    "build": "run-p ng:build:prod",
    "start": "run-p ng:serve",
    "start:dev": "run-p ng:serve:dev",
    "test:e2e": "playwright test",
    "test:scripts": "node --test scripts/"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/pwa": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "@pdfme/common": "^6.0.6",
    "@pdfme/generator": "^6.0.6",
    "@pdfme/schemas": "^6.0.6",
    "@pdfme/ui": "^6.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/geojson": "^7946.0.16",
    "angular-split": "^20.0.0",
    "dexie": "^4.2.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "immer": "^11.2.10",
    "jspdf": "^4.2.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "material-icons": "^1.13.14",
    "ngx-quill": "^31.0.1",
    "ol-ext": "^4.0.37",
    "ol-mapbox-style": "^13.9.0",
    "ol-pmtiles": "^2.0.2",
    "proj4": "^2.20.2",
    "qrcode": "^1.5.4",
    "quill": "^2.0.3",
    "rxjs": "~7.8.2",
    "shpjs": "^6.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ts-md5": "^2.0.1",
    "tslib": "^2.8.1",
    "uuid": "^14.0.3",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@playwright/test": "^1.57.0",
    "@types/jasmine": "^7.0.0",
    "@types/lodash": "^4.17.21",
    "@types/luxon": "^3.7.1",
    "@types/ol-ext": "npm:@siedlerchr/types-ol-ext@^3.6.5",
    "@types/proj4": "^2.5.6",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~6.0.3"
  }
}
